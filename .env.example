# Copy this file to .env and fill in your values

# Required for AI journal generation (Claude API)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Binance API credentials (only needed for private endpoints)
# Public market data endpoints work without authentication
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_RETRIES=1

# Optional: CoinGlass API key for real aggregated derivatives data
# (funding rates, open interest, liquidations across all exchanges)
# Free tier available at: https://coinglass.com/pricing
COINGLASS_API_KEY=your_coinglass_key_here

# Telegram daily trade notifications (sent at 8AM SGT every day)
# 1. Create a bot via @BotFather → get token
# 2. Create a public channel → add bot as admin with "Post Messages" permission
# 3. Set TELEGRAM_CHAT_ID to @YourChannelUsername
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Public channel: @YourChannelUsername
# Private channel or supergroup: numeric ID (negative number, e.g. -1003529898229)
# Get numeric ID: send a message to the group, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and look for "chat":{"id":
TELEGRAM_CHAT_ID=@YourChannelUsername

# Exact-once dedup for pattern-confirmation alerts (OPTIONAL).
# Without these, dedup falls back to a local file (best-effort; a serverless
# cold start may occasionally re-send). Provision a free Upstash Redis (or add
# Vercel KV — it injects KV_REST_API_* automatically) for guaranteed exact-once.
# Set EITHER pair:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# X (Twitter) daily BTC + ETH 1D signal thread (@EthSayn1560)
# 1. Go to developer.twitter.com → Create Project → Create App
# 2. Set App permissions to "Read and Write"
# 3. Generate Access Token & Secret (under "Keys and tokens")
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here

# Server port (default 8000)
PORT=8000

# FRED (Federal Reserve Economic Data) — powers the Macro Events section.
# Free key, instant approval: https://fred.stlouisfed.org/docs/api/api_key.html
# Required on cloud hosts (Vercel): FRED's public CSV endpoint blocks
# datacenter IPs, so the official API is the only reliable path there.
FRED_API_KEY=your_fred_key_here

# SoSoValue Open API — powers the Spot ETF Flows section (BTC/ETH daily
# net inflow/outflow). Free key: sign in at sosovalue.com → API management
# (developer/open API) → create key. CoinGlass ETF endpoints require a paid
# plan, so this is the free path for ETF data.
SOSOVALUE_API_KEY=your_sosovalue_key_here

# Etherscan V2 API — unlocks on-chain GOMINING burn tracking (ETH + BNB Chain
# with one key). Free: https://etherscan.io/register → API Keys.
ETHERSCAN_API_KEY=your_etherscan_key_here

# Taostats API — powers the Bittensor Ecosystem section on the TAO view
# (staking %, subnet Alpha prices, net TAO flow into subnet pools).
# Get a key at https://taostats.io/pro (free tier: 5 calls/min — the app
# caches aggregates 30 min so this is plenty).
TAOSTATS_API_KEY=your_taostats_key_here

# ── Persistent signal tracking (Neon Postgres via Vercel Marketplace) ────────
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_/VITE_, never return it from
# an API, never log it, never commit the real value.
#
# Vercel injects this automatically once the Neon integration is connected to
# the project (Vercel -> Project -> Storage / Integrations -> Neon). Locally,
# copy the connection string from the Neon dashboard.
#
# Prefer Neon's POOLED host (it contains "-pooler") for serverless.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# When true, a signal is NOT published (API, Telegram or cron) unless its
# database transaction committed — no silently lost signals. Production: true.
# Leave false locally, or in a deploy with no database, to keep the app working
# exactly as it did before persistence existed.
DB_REQUIRED=false

# Identifies the rule-set that produced a signal. Bump when the signal maths
# changes so old and new signals stay independently analysable.
STRATEGY_VERSION=v42_tpfilter

# Environment label written on every stored signal. DATABASE_URL is shared
# across Vercel environments, so this is how a preview deploy's rows are told
# apart from production's — and it is part of the idempotency key, so the two
# never claim the same candle from each other.
# Defaults to Vercel's own VERCEL_ENV (production / preview / development), then
# to "local". Set it explicitly only for something Vercel does not name, e.g. a
# staging deploy, or a local process pointed at a shared database.
# SIGNAL_ENVIRONMENT=staging

# Optional tuning for serverless connections (defaults shown).
# DB_CONNECT_TIMEOUT=10
# DB_STATEMENT_TIMEOUT_MS=15000

# Separate database used ONLY by the database tests. Tests are destructive
# within their own schema — NEVER point this at production Neon.
# Without it, the database-backed tests skip and the rest of the suite runs.
TEST_DATABASE_URL=
